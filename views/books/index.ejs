<%- include('../layouts/header') %>

  <div class="container py-4">

    <!-- Page Header -->
    <div class="catalogue-header mb-4">
      <div class="catalogue-header-inner">
        <div class="catalogue-header-text">
          <h2 class="catalogue-title">
            <span class="catalogue-title-icon"><i class="bi bi-book-half"></i></span>
            Library Book Catalogue
          </h2>
          <p class="catalogue-subtitle">Discover, explore, and borrow from our comprehensive educational collection</p>
        </div>
        <% if (isLibrarian) { %>
          <a href="/books/new" class="btn btn-library-primary btn-add-book">
            <i class="bi bi-plus-circle me-2"></i>Add New Book
          </a>
          <% } %>
      </div>
    </div>

    <!-- Search & Filter Panel -->
    <div class="catalogue-search-panel mb-4">
      <form action="/books" method="GET" class="catalogue-search-form" autocomplete="off">
        <div class="catalogue-search-field">
          <span class="catalogue-search-icon"><i class="bi bi-search"></i></span>
          <input type="text" class="catalogue-search-input" name="query" value="<%= searchQuery %>"
            placeholder="Search by title, author, category or ISBN…">
          <% if (searchQuery) { %>
            <a href="/books<%= selectedCategory && selectedCategory !== 'All' ? '?category=' + encodeURIComponent(selectedCategory) : '' %>"
              class="catalogue-search-clear" title="Clear search">
              <i class="bi bi-x-lg"></i>
            </a>
            <% } %>
        </div>
        <div class="catalogue-filter-field">
          <span class="catalogue-filter-icon"><i class="bi bi-funnel"></i></span>
          <select class="catalogue-filter-select" name="category" onchange="this.form.submit()">
            <option value="All" <%=selectedCategory==='All' ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(function(cat) { %>
              <option value="<%= cat %>" <%=selectedCategory===cat ? 'selected' : '' %>><%= cat %>
              </option>
              <% }); %>
          </select>
        </div>
      </form>
    </div>

    <!-- Results Bar -->
    <% if (books.length> 0) { %>
      <div class="catalogue-results-bar mb-3">
        <i class="bi bi-grid-3x3-gap-fill me-1 text-muted"></i>
        <span>
          <strong>
            <%= books.length %>
          </strong>
          <%= books.length===1 ? 'book' : 'books' %>
            <% if (searchQuery) { %> matching "<em>
                <%= searchQuery %>
              </em>"<% } %>
                <% if (selectedCategory && selectedCategory !=='All' ) { %> in <em>
                    <%= selectedCategory %>
                  </em>
                  <% } %>
        </span>
      </div>
      <% } %>

        <!-- Grid -->
        <% if (books.length===0) { %>
          <div class="catalogue-empty">
            <div class="catalogue-empty-icon"><i class="bi bi-journal-x"></i></div>
            <h4 class="catalogue-empty-title">No books found</h4>
            <p class="catalogue-empty-msg">No titles matched your search or filter. Try different keywords.</p>
            <a href="/books" class="btn btn-library-navy">
              <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
            </a>
          </div>
          <% } else { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
              <% books.forEach(function(book) { var catSlug=(book.category || ''
                ).toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,''); var stockPct=book.totalCopies> 0 ?
                Math.round((book.availableCopies / book.totalCopies) * 100) : 0;
                var isAlreadyBorrowed = (isAuthenticated && isMember) ?
                userActiveLoanBookIds.includes(book._id.toString()) : false;
                %>
                <div class="col">
                  <div class="book-card">
                    <!-- Cover -->
                    <div class="book-cover-wrap">
                      <img src="<%= book.coverImage || '/images/default-book-cover.png' %>" alt="<%= book.title %>"
                        class="book-cover-img" loading="lazy"
                        onerror="this.onerror=null;this.src='/images/default-book-cover.png';">
                      <span class="book-cat-badge cat-<%= catSlug %>">
                        <%= book.category %>
                      </span>
                      <% if (book.availableCopies> 0) { %>
                        <span class="book-avail-pill avail-in"><i class="bi bi-check-circle-fill"></i> Available</span>
                        <% } else { %>
                          <span class="book-avail-pill avail-out"><i class="bi bi-dash-circle-fill"></i> Out</span>
                          <% } %>
                            <div class="book-cover-overlay">
                              <a href="/books/<%= book._id %>" class="book-overlay-cta">
                                <i class="bi bi-eye me-1"></i>View Details
                              </a>
                            </div>
                    </div>
                    <!-- Body -->
                    <div class="book-card-body">
                      <h5 class="book-title" title="<%= book.title %>">
                        <%= book.title %>
                      </h5>
                      <p class="book-author"><i class="bi bi-person-fill me-1"></i>
                        <%= book.author %>
                      </p>
                      <div class="book-isbn-row">
                        <span class="book-isbn-label">ISBN</span>
                        <code class="book-isbn-code"><%= book.isbn %></code>
                      </div>
                      <div class="book-stock-wrap">
                        <div class="book-stock-track">
                          <div class="book-stock-fill <%= stockPct === 0 ? 'stock-empty' : '' %>"
                            style="--stock-width: <%= stockPct %>%">
                          </div>
                        </div>
                        <span class="book-stock-label">
                          <%= book.availableCopies %>/<%= book.totalCopies %> copies
                        </span>
                      </div>
                      <div class="book-action-wrap mt-auto">
                        <% if (isAuthenticated && isMember) { %>
                          <% if (isAlreadyBorrowed) { %>
                            <button class="btn book-action-btn state-issued" disabled>
                              <i class="bi bi-check2-all me-1"></i>Already Issued
                            </button>
                            <% } else if (memberActiveLoanCount>= 5) { %>
                              <button class="btn book-action-btn state-limit" disabled title="5-book limit reached">
                                <i class="bi bi-slash-circle me-1"></i>Limit Reached
                              </button>
                              <% } else if (book.availableCopies> 0) { %>
                                <form action="/books/<%= book._id %>/issue" method="POST" class="d-grid m-0">
                                  <button type="submit" class="btn book-action-btn state-borrow">
                                    <i class="bi bi-journal-arrow-down me-1"></i>Borrow Book
                                  </button>
                                </form>
                                <% } else { %>
                                  <button class="btn book-action-btn state-unavailable" disabled>
                                    <i class="bi bi-hourglass-split me-1"></i>Unavailable
                                  </button>
                                  <% } %>
                                    <% } else if (!isAuthenticated) { %>
                                      <a href="/auth/login" class="btn book-action-btn state-login">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>Login to Borrow
                                      </a>
                                      <% } else { %>
                                        <a href="/books/<%= book._id %>" class="btn book-action-btn state-view">
                                          <i class="bi bi-info-circle me-1"></i>View Details
                                        </a>
                                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
                <% }); %>
            </div>
            <% } %>

  </div>

  <%- include('../layouts/footer') %>