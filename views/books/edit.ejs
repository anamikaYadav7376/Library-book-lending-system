<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <span class="badge bg-warning text-dark text-uppercase px-2 py-1 mb-1">Librarian Operations</span>
          <h2 class="fw-bold text-navy mb-0">Edit Book Information</h2>
        </div>
        <a href="/books/<%= book._id %>" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left me-1"></i> Back to Details
        </a>
      </div>

      <!-- Current Circulation Advisory -->
      <% const issuedCopies = book.totalCopies - book.availableCopies; %>
      <div class="alert alert-info d-flex align-items-center mb-4">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
          <div class="fw-bold">Current Circulation Status:</div>
          <div>
            Total: <strong><%= book.totalCopies %></strong> &bull; Available: <strong><%= book.availableCopies %></strong> &bull; Currently Issued: <strong><%= issuedCopies %></strong>
          </div>
          <small class="text-muted">You cannot set total copies lower than <%= issuedCopies %> (active loans).</small>
        </div>
      </div>

      <div class="form-card">
        <form action="/books/<%= book._id %>?_method=PUT" method="POST">
          <div class="row g-3">
            <div class="col-md-12">
              <label for="title" class="form-label">Book Title <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="title"
                name="title"
                value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : book.title %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="author" class="form-label">Author Name <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="author"
                name="author"
                value="<%= typeof formData !== 'undefined' && formData.author ? formData.author : book.author %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="isbn" class="form-label">ISBN Identification <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="isbn"
                name="isbn"
                value="<%= typeof formData !== 'undefined' && formData.isbn ? formData.isbn : book.isbn %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="category" class="form-label">Subject / Category <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="category"
                name="category"
                value="<%= typeof formData !== 'undefined' && formData.category ? formData.category : book.category %>"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="totalCopies" class="form-label">Total Copies in Collection <span class="text-danger">*</span></label>
              <input
                type="number"
                class="form-control"
                id="totalCopies"
                name="totalCopies"
                min="<%= issuedCopies %>"
                value="<%= typeof formData !== 'undefined' && formData.totalCopies ? formData.totalCopies : book.totalCopies %>"
                required
              >
              <div class="form-text">Minimum allowed: <%= issuedCopies %> (cannot be lower than currently issued copies).</div>
            </div>

            <div class="col-md-12">
              <label for="coverImage" class="form-label">Cover Image URL</label>
              <input
                type="url"
                class="form-control"
                id="coverImage"
                name="coverImage"
                value="<%= typeof formData !== 'undefined' && formData.coverImage ? formData.coverImage : book.coverImage %>"
                placeholder="https://example.com/cover.jpg"
              >
            </div>

            <div class="col-md-12">
              <label for="description" class="form-label">Overview / Abstract</label>
              <textarea
                class="form-control"
                id="description"
                name="description"
                rows="4"
              ><%= typeof formData !== 'undefined' && formData.description ? formData.description : book.description %></textarea>
            </div>

            <div class="col-md-12 pt-3 border-top d-flex justify-content-end gap-2">
              <a href="/books/<%= book._id %>" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-library-primary">
                <i class="bi bi-check-lg me-1"></i> Save Changes
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
