<%- include('../layouts/header') %>

<div class="container py-5 text-center">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 shadow-sm p-5 rounded-4">
        <div class="mb-4">
          <span class="display-1 fw-bold text-danger">500</span>
          <div class="text-muted fs-4">Internal Server Error</div>
        </div>
        <p class="text-secondary mb-4">
          <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while processing your library request. Our administrators have been notified.' %>
        </p>
        <div class="d-flex justify-content-center gap-3">
          <a href="/" class="btn btn-library-navy">
            <i class="bi bi-house-door me-1"></i> Return to Safety
          </a>
          <a href="/books" class="btn btn-outline-secondary">
            <i class="bi bi-grid-fill me-1"></i> Book Catalogue
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
