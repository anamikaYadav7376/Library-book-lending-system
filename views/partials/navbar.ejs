                <i class="bi bi-book-half me-1"></i> My Loans
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/account' ? 'active' : '' %>" href="/account">
                <i class="bi bi-person-badge-fill me-1"></i> Account
              </a>
            </li>
          <% } %>

