            <i class="bi bi-grid-fill me-1"></i> Catalogue
          </a>
        </li>

        <% if (isAuthenticated) { %>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">
              <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
          </li>

