<%- include('../layouts/header') %>

<div class="container py-4">
  <!-- Welcome Banner -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
    <div>
      <span class="badge bg-primary text-uppercase px-2 py-1 mb-1">Member Portal</span>
      <h2 class="fw-bold text-navy mb-0">Welcome, <%= user.name %></h2>
      <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i><%= user.email %></p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/account" class="btn btn-outline-secondary">
        <i class="bi bi-person-badge me-1"></i> My Account & Fines
      </a>
      <a href="/books" class="btn btn-library-primary">
        <i class="bi bi-book-half me-1"></i> Browse Catalogue
      </a>
    </div>
  </div>

  <!-- Overdue Banner Alert if any -->
  <% if (stats.overdue > 0 && stats.outstandingFine > 0) { %>
    <div class="alert alert-danger d-flex align-items-center shadow-sm mb-4" role="alert">
      <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
      <div>
        <h5 class="alert-heading fw-bold mb-1">Attention: You have <%= stats.overdue %> overdue book(s)!</h5>
        <p class="mb-0 small">
          Please settle outstanding fines to return overdue materials. Penalty rate is <strong>₹5 per day</strong>. Total pending fine: <strong>₹<%= stats.outstandingFine %></strong>.
        </p>
      </div>
    </div>
  <% } %>

  <!-- Statistics Row -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="stat-label">Current Loans</div>
          <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
            <i class="bi bi-book"></i>
          </div>
        </div>
        <div class="stat-number"><%= stats.currentlyBorrowed %> <span class="fs-6 text-muted fw-normal">/ 5 max</span></div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="stat-label">Overdue Books</div>
          <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-exclamation-octagon"></i>
          </div>
        </div>
        <div class="stat-number text-danger"><%= stats.overdue %></div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="stat-label">Outstanding Fine</div>
          <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger">
            <i class="bi bi-wallet2"></i>
          </div>
        </div>
        <div class="stat-number text-danger">₹<%= stats.outstandingFine %></div>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="stat-label">Total Paid Fines</div>
          <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
            <i class="bi bi-cash-stack"></i>
          </div>
        </div>
        <div class="stat-number text-success">₹<%= stats.paidFines %></div>
      </div>
    </div>
  </div>

  <!-- Currently Borrowed Books Section -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0 text-navy">
        <i class="bi bi-journal-bookmark me-2 text-primary"></i>Currently Borrowed Books
      </h5>
      <span class="badge bg-secondary"><%= activeLoans.length %> Active</span>
    </div>
    <div class="card-body p-0">
      <% if (activeLoans.length === 0) { %>
        <div class="p-5 text-center text-muted">
          <i class="bi bi-journal-check display-4 text-secondary mb-2 d-block"></i>
          <p class="mb-2">You currently have no books on loan.</p>
          <a href="/books" class="btn btn-sm btn-library-primary">Explore Book Catalogue</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 table-library">
            <thead>
              <tr>
                <th scope="col" style="width: 70px;">Cover</th>
                <th scope="col">Title & Author</th>
                <th scope="col">Due Date</th>
                <th scope="col">Status</th>
                <th scope="col">Fine</th>
                <th scope="col" class="text-end" style="min-width: 170px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% activeLoans.forEach(function(loan) { %>
                <tr>
                  <td>
                    <div style="width: 48px; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 4px;">
                      <img
                        src="<%= loan.book ? loan.book.coverImage : '/images/default-book-cover.png' %>"
                        alt="Book Cover"
                        class="w-100 h-100"
                        style="object-fit: cover;"
                        onerror="this.onerror=null;this.src='/images/default-book-cover.png';"
                      >
                    </div>
                  </td>
                  <td>
                    <% if (loan.book) { %>
                      <a href="/books/<%= loan.book._id %>" class="fw-bold text-navy text-decoration-none d-block">
                        <%= loan.book.title %>
                      </a>
                      <small class="text-muted"><%= loan.book.author %> &bull; <%= loan.book.category %></small>
                    <% } else { %>
                      <span class="text-danger">Book removed</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="<%= loan.isOverdue ? 'text-danger fw-bold' : '' %>">
                      <%= new Date(loan.dueDate).toLocaleDateString('en-GB') %>
                    </span>
                  </td>
                  <td>
                    <% if (loan.isOverdue) { %>
                      <span class="badge badge-overdue">
                        Overdue by <%= loan.overdueDays %> day<%= loan.overdueDays > 1 ? 's' : '' %>
                      </span>
                    <% } else { %>
                      <span class="badge badge-issued">Active</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (loan.calculatedFine > 0) { %>
                      <span class="fine-badge">₹<%= loan.calculatedFine %></span>
                      <% if (loan.finePaid) { %>
                        <span class="badge bg-success ms-1">PAID</span>
                      <% } else { %>
                        <span class="badge bg-danger ms-1">UNPAID</span>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted">₹0</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <% if (loan.paymentPending) { %>
                      <!-- Fine is unpaid: Must pay before returning -->
                      <a href="/loans/<%= loan._id %>/pay" class="btn btn-warning btn-sm fw-bold shadow-sm">
                        <i class="bi bi-wallet2 me-1"></i> Pay Fine: ₹<%= loan.calculatedFine %>
                      </a>
                    <% } else { %>
                      <!-- On-time or fine paid: Allow return -->
                      <% if (loan.finePaid) { %>
                        <span class="badge bg-success-subtle text-success border border-success mb-1 d-inline-block">
                          <i class="bi bi-check-circle-fill me-1"></i> Fine Paid ✓
                        </span>
                        <br>
                      <% } %>
                      <form
                        action="/loans/<%= loan._id %>/return"
                        method="POST"
                        class="d-inline confirm-return-form"
                        data-book-title="<%= loan.book ? loan.book.title : 'this book' %>"
                      >
                        <button type="submit" class="btn btn-outline-success btn-sm">
                          <i class="bi bi-arrow-return-left me-1"></i> Return Book
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent Borrowing History Section -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0 text-navy">
        <i class="bi bi-clock-history me-2 text-secondary"></i>Recent Borrowing History
      </h5>
      <a href="/account" class="small text-decoration-none fw-semibold">View Full Payment History</a>
    </div>
    <div class="card-body p-0">
      <% if (borrowingHistory.length === 0) { %>
        <div class="p-4 text-center text-muted small">
          No past returned books yet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 table-library">
            <thead>
              <tr>
                <th scope="col">Book Title</th>
                <th scope="col">Borrowed On</th>
                <th scope="col">Returned On</th>
                <th scope="col">Fine Settled</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              <% borrowingHistory.forEach(function(item) { %>
                <tr>
                  <td>
                    <div class="fw-semibold text-navy"><%= item.book ? item.book.title : 'Unknown' %></div>
                    <small class="text-muted"><%= item.book ? item.book.author : '' %></small>
                  </td>
                  <td><%= new Date(item.issueDate).toLocaleDateString('en-GB') %></td>
                  <td><%= item.returnDate ? new Date(item.returnDate).toLocaleDateString('en-GB') : '-' %></td>
                  <td>
                    <% if (item.fine > 0) { %>
                      <span class="fine-badge">₹<%= item.fine %> (Paid)</span>
                    <% } else { %>
                      <span class="text-muted">₹0</span>
                    <% } %>
                  </td>
                  <td><span class="badge badge-returned">Returned</span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
