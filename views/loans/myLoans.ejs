<%- include('../layouts/header') %>

<div class="container py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
    <div>
      <span class="badge bg-primary text-uppercase px-2 py-1 mb-1">My Account</span>
      <h2 class="fw-bold text-navy mb-0">My Borrowed Books & Circulation</h2>
      <p class="text-muted small mb-0">Track your current book loans, upcoming return deadlines, and pay overdue fines</p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
      <a href="/account" class="btn btn-outline-secondary">
        <i class="bi bi-person-badge me-1"></i> Account & Payment History
      </a>
      <a href="/books" class="btn btn-library-primary">
        <i class="bi bi-journal-plus me-1"></i> Borrow Another Book
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-label">Currently Issued</div>
        <div class="stat-number text-primary mt-1"><%= stats.activeCount %> <span class="fs-6 text-muted fw-normal">/ 5 max</span></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-label">Overdue Books</div>
        <div class="stat-number text-danger mt-1"><%= stats.overdueCount %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-label">Outstanding Fines</div>
        <div class="stat-number text-danger mt-1">₹<%= stats.outstandingFine %></div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card">
        <div class="stat-label">Paid Fines</div>
        <div class="stat-number text-success mt-1">₹<%= stats.paidFines %></div>
      </div>
    </div>
  </div>

  <!-- Loans Table Card -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="fw-bold mb-0 text-navy">
        <i class="bi bi-card-list me-2 text-primary"></i>All Loan Records (<%= loans.length %>)
      </h5>
    </div>
    <div class="card-body p-0">
      <% if (loans.length === 0) { %>
        <div class="p-5 text-center text-muted">
          <i class="bi bi-book display-4 text-secondary mb-3 d-block"></i>
          <h5>No loans recorded yet</h5>
          <p class="mb-3">You have not borrowed any books from our library yet.</p>
          <a href="/books" class="btn btn-library-primary">Browse Catalogue Now</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 table-library">
            <thead>
              <tr>
                <th scope="col" style="width: 75px;">Cover</th>
                <th scope="col">Book Information</th>
                <th scope="col">Issued On</th>
                <th scope="col">Due Date</th>
                <th scope="col">Status</th>
                <th scope="col">Fine</th>
                <th scope="col">Payment</th>
                <th scope="col" class="text-end" style="min-width: 170px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% loans.forEach(function(loan) { %>
                <tr>
                  <td>
                    <div style="width: 50px; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 4px; box-shadow: var(--shadow-sm);">
                      <img
                        src="<%= loan.book ? loan.book.coverImage : '/images/default-book-cover.png' %>"
                        alt="Cover"
                        class="w-100 h-100"
                        style="object-fit: cover;"
                        onerror="this.onerror=null;this.src='/images/default-book-cover.png';"
                      >
                    </div>
                  </td>
                  <td>
                    <% if (loan.book) { %>
                      <a href="/books/<%= loan.book._id %>" class="fw-bold text-navy text-decoration-none">
                        <%= loan.book.title %>
                      </a>
                      <div class="small text-muted">
                        <%= loan.book.author %> &bull; <%= loan.book.category %>
                      </div>
                      <div class="small text-muted">ISBN: <%= loan.book.isbn %></div>
                    <% } else { %>
                      <span class="text-danger fw-semibold">Archived Title</span>
                    <% } %>
                  </td>
                  <td><%= new Date(loan.issueDate).toLocaleDateString('en-GB') %></td>
                  <td>
                    <span class="<%= loan.isOverdue ? 'text-danger fw-bold' : '' %>">
                      <%= new Date(loan.dueDate).toLocaleDateString('en-GB') %>
                    </span>
                  </td>
                  <td>
                    <% if (loan.status === 'returned') { %>
                      <span class="badge badge-returned">Returned</span>
                      <% if (loan.returnDate) { %>
                        <div class="small text-muted"><%= new Date(loan.returnDate).toLocaleDateString('en-GB') %></div>
                      <% } %>
                    <% } else if (loan.isOverdue) { %>
                      <span class="badge badge-overdue">
                        Overdue (<%= loan.overdueDays %>d)
                      </span>
                    <% } else { %>
                      <span class="badge badge-issued">Active (Issued)</span>
                    <% } %>
                  </td>
                  <td>
                    <% const displayFine = loan.status === 'returned' ? (loan.fine || 0) : loan.calculatedFine; %>
                    <% if (displayFine > 0) { %>
                      <span class="fine-badge">₹<%= displayFine %></span>
                    <% } else { %>
                      <span class="text-muted">₹0</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (loan.status === 'returned') { %>
                      <% if (loan.fine > 0) { %>
                        <span class="badge bg-success">PAID</span>
                      <% } else { %>
                        <span class="text-muted small">None</span>
                      <% } %>
                    <% } else if (loan.isOverdue) { %>
                      <% if (loan.finePaid) { %>
                        <span class="badge bg-success">PAID</span>
                      <% } else { %>
                        <span class="badge bg-danger">UNPAID</span>
                      <% } %>
                    <% } else { %>
                      <span class="text-muted small">None</span>
                    <% } %>
                  </td>
                  <td class="text-end">
                    <% if (loan.status !== 'returned') { %>
                      <% if (loan.paymentPending) { %>
                        <!-- Overdue and fine unpaid: Must pay fine before returning! -->
                        <a href="/loans/<%= loan._id %>/pay" class="btn btn-warning btn-sm fw-bold shadow-sm">
                          <i class="bi bi-wallet2 me-1"></i> Pay Fine: ₹<%= loan.calculatedFine %>
                        </a>
                      <% } else { %>
                        <!-- On-time or fine paid: Allow return -->
                        <% if (loan.finePaid) { %>
                          <span class="badge bg-success-subtle text-success border border-success mb-1 d-inline-block">
                            <i class="bi bi-check-circle-fill me-1"></i> Fine Paid ✓
                          </span>
                          <br>
                        <% } %>
                        <form
                          action="/loans/<%= loan._id %>/return"
                          method="POST"
                          class="d-inline confirm-return-form"
                          data-book-title="<%= loan.book ? loan.book.title : 'this book' %>"
                        >
                          <button type="submit" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-arrow-return-left me-1"></i> Return Book
                          </button>
                        </form>
                      <% } %>
                    <% } else { %>
                      <button class="btn btn-sm btn-light border text-muted" disabled>
                        <i class="bi bi-check-all me-1"></i> Completed
                      </button>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
