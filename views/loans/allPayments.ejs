<%- include('../layouts/header') %>

<div class="container-fluid px-0">
  <div class="row g-0">
    <!-- Admin Sidebar -->
    <div class="col-lg-2 d-none d-lg-block">
      <%- include('../partials/sidebar') %>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-10 p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
        <div>
          <span class="badge bg-danger text-uppercase px-2 py-1 mb-1">Administration</span>
          <h2 class="fw-bold text-navy mb-0">Fine Payments & Transactions</h2>
          <p class="text-muted small mb-0">Complete audit trail of all library fines collected from patrons</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
          <div class="badge bg-success fs-6 px-3 py-2">
            <i class="bi bi-cash-stack me-1"></i> Total Collected: ₹<%= stats.totalCollected %>
          </div>
          <div class="badge bg-secondary fs-6 px-3 py-2">
            <i class="bi bi-receipt me-1"></i> Transactions: <%= stats.totalPaymentsCount %>
          </div>
        </div>
      </div>

      <!-- Search Box -->
      <div class="search-filter-box mb-4">
        <form action="/loans/payments" method="GET" class="row g-2 align-items-center">
          <div class="col-md-9 col-lg-10">
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
              <input
                type="text"
                class="form-control"
                name="search"
                value="<%= searchQuery %>"
                placeholder="Search payments by member name, email, book title, ISBN or transaction ID..."
              >
            </div>
          </div>
          <div class="col-md-3 col-lg-2 d-flex gap-2">
            <button type="submit" class="btn btn-library-primary w-100">
              <i class="bi bi-funnel me-1"></i> Search
            </button>
            <% if (searchQuery) { %>
              <a href="/loans/payments" class="btn btn-outline-secondary">Reset</a>
            <% } %>
          </div>
        </form>
      </div>

      <!-- Payments Table -->
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
          <% if (payments.length === 0) { %>
            <div class="p-5 text-center text-muted">
              <i class="bi bi-receipt-cutoff display-4 text-secondary mb-3 d-block"></i>
              <p class="mb-0">No fine payment records found matching your query.</p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0 table-library">
                <thead>
                  <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Member / Patron</th>
                    <th scope="col">Book Information</th>
                    <th scope="col">Fine Amount</th>
                    <th scope="col">Amount Paid</th>
                    <th scope="col">Payment Method</th>
                    <th scope="col">Transaction ID</th>
                    <th scope="col" class="text-end">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% payments.forEach(function(p) { %>
                    <tr>
                      <td>
                        <%= new Date(p.paymentDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                        <div class="text-muted small"><%= new Date(p.paymentDate).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %></div>
                      </td>
                      <td>
                        <% if (p.user) { %>
                          <div class="fw-bold text-navy"><%= p.user.name %></div>
                          <small class="text-muted"><%= p.user.email %></small>
                        <% } else { %>
                          <span class="text-muted">Unknown User</span>
                        <% } %>
                      </td>
                      <td>
                        <% if (p.loan && p.loan.book) { %>
                          <div class="fw-semibold text-dark"><%= p.loan.book.title %></div>
                          <small class="text-muted">ISBN: <%= p.loan.book.isbn %></small>
                        <% } else { %>
                          <span class="text-muted">Archived Book</span>
                        <% } %>
                      </td>
                      <td>₹<%= p.amount %></td>
                      <td><strong class="text-success">₹<%= p.amount %></strong></td>
                      <td>
                        <span class="badge bg-light text-dark border">
                          <%= p.paymentMethod %>
                        </span>
                      </td>
                      <td><code><%= p.transactionId %></code></td>
                      <td class="text-end">
                        <span class="badge bg-success text-uppercase">
                          <%= p.status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
